# =============================================================================
# AI Marketing Intelligence Platform — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in real values.

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=AI-Marketing-Platform
APP_ENV=development
DEBUG=false
SECRET_KEY=generate-with-python-c-import-secrets-print-secrets-token_urlsafe-64
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://platform:platform@localhost:5432/marketing_platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
POSTGRES_DB=marketing_platform

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Telegram Bot ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook/telegram

# ── Telegram Export (Telethon userbot sessions) ─────────────────────────────
# Fernet key for encrypting Telethon session strings and API hashes in DB.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TELEGRAM_ENCRYPTION_KEY=

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONITOR=price_...
STRIPE_PRICE_CREATOR=price_...
STRIPE_PRICE_AUTOPILOT=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# ── Web Push (VAPID) ────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# ── AI — Atlas Cloud (unified gateway, replaces individual provider keys) ────
ATLAS_CLOUD_API_KEY=your-atlas-cloud-api-key
ATLAS_CLOUD_BASE_URL=https://api.atlascloud.ai/api/v1

# ── AI / LLM (legacy — kept for fallback) ───────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Vector Database (Qdrant) ────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── S3 Storage ───────────────────────────────────────────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=marketing-platform
S3_REGION=us-east-1

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret
